                "v.raise_back = math.clamp((v.t - q.stage_end(3) + 5) / 5, 0, 1)",
                "v.intensity = 2 * math.easeoutcirc(v.sway) - 2 * math.easeincirc(v.raise_back)",
                "v.slow = math.sin(v.t * 19) * v.intensity",
                "v.fast = math.sin(v.t * 30) * v.intensity",
                "v.a = -65 * math.easeinoutback(v.raise, 2.5949) - 35 * v.lower + 100 * v.raise_back - 0.5 * v.fast",
                "v.th = -90 * math.clamp((v.raise - 0.5) / 0.05, 0, 1) + 90 * v.sway + 2 * v.slow",
                "v.x = v.raise * 0.15 - v.raise_end * 0.05 - v.sway * 0.1 + v.slow * 0.005 + 0.15 * (1 - math.cos(v.th))",
                "v.y = -v.raise * 0.075 + v.raise_middle * 0.075 + v.fast * 0.01 + 0.1 - 0.1 * math.cos(v.a) + 0.15 * math.sin(v.th) * math.sin(v.a)",
                "v.z = v.raise_start * 0.05 - v.raise_end * 0.05 + v.slow * 0.005 - 0.1 * math.sin(v.a) - 0.15 * math.sin(v.th) * math.cos(v.a)",
                "v.hit = 0.4 * (math.easeoutquart(math.clamp((q.ticks_since_hit - 1) / 2, 0, 1)) - math.easeinoutsine(math.clamp((q.ticks_since_hit - 3) / 7, 0, 1)))"
            ],
            "bones": {
                "item": {
                    "rotation": ["v.a", "-v.th", 0],
                    "position": ["v.x * 16", "-(v.y - v.hit * math.cos(v.a)) * 16", "(v.z - v.hit * math.sin(v.a)) * 16"]
                }
            }
        }
    }
