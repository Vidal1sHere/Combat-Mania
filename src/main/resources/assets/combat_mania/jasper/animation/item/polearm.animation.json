                "v.raise_middle = math.clamp((v.raise - 0.5) / 0.3, 0, 1)",
                "v.raise_end = math.clamp((v.raise - 0.8) / 0.2, 0, 1)",
                "v.sway = math.clamp((v.t - q.stage_end(1) + 20) / math.max(q.stage_end(2) - 40 - q.stage_end(1) + 20, 1), 0, 1)",
