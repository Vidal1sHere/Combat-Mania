        "joust": {
            "loop": true,
            "animation_length": 1.0,
            "bone_modes": {"right_arm": "additive"},
            "pre_animation": [
                "v.t = q.anim_time * 20",
                "v.raise = math.clamp(v.t / math.max(q.stage_end(0), 1), 0, 1)",
                "v.raise_start = math.clamp(v.raise / 0.5, 0, 1)",
                "v.raise_middle = math.clamp((v.raise - 0.5) / 0.3, 0, 1)",
                "v.raise_end = math.clamp((v.raise - 0.8) / 0.2, 0, 1)",
                "v.sway = math.clamp((v.t - q.stage_end(1) + 20) / math.max(q.stage_end(2) - 40 - q.stage_end(1) + 20, 1), 0, 1)",
                "v.lower = math.easeoutcubic(math.easeinoutelastic(math.clamp((v.t - q.stage_end(2) + 20) / 40, 0, 1), 0.66667))",
                "v.raise_back = math.clamp((v.t - q.stage_end(3) + 5) / 5, 0, 1)",
                "v.intensity = 2 * math.easeoutcirc(v.sway) - 2 * math.easeincirc(v.raise_back)",
                "v.slow = math.sin(v.t * 19) * v.intensity",
                "v.fast = math.sin(v.t * 30) * v.intensity",
                "v.al = 70 * (v.raise - v.raise_back)",
                "v.g = -90 * (v.raise - v.sway)",
                "v.sa = math.sin(v.al)",
                "v.ca = math.cos(v.al)",
                "v.sg = math.sin(v.g)",
                "v.cg = math.cos(v.g)",
                "v.lift = 2.70158 * v.raise * v.raise * v.raise - 1.70158 * v.raise * v.raise",
                "v.hit = 0.4 * (math.easeoutquart(math.clamp((q.ticks_since_hit - 1) / 2, 0, 1)) - math.easeinoutsine(math.clamp((q.ticks_since_hit - 3) / 7, 0, 1)))"
            ],
            "bones": {
                "right_arm": {
                    "rotation": [
                        "-40 * v.raise_start + 30 * v.raise_middle - 20 * v.raise_end + 20 * v.lower + 10 * v.raise_back + 0.6 * v.slow * v.intensity",
                        "v.fast * v.intensity",
                        "0.5 * v.slow * v.intensity"
                    ]
                },
                "right_item": {
                    "rotation": ["math.atan2(v.sa * v.cg, v.ca)", "-math.asin(v.sa * v.sg)", "math.atan2(v.ca * v.sg, v.cg)"],
                    "position": [
                        "-2 * v.sg",
                        "2 - 2 * v.ca - 0.5 * v.sa - (2 * v.cg - 2) * v.ca + 16 * (v.hit - 0.38 * (v.lift - v.raise_back))",
                        "0.5 + 2 * v.sa - 0.5 * v.ca + (2 * v.cg - 2) * v.sa + 6.4 * v.hit"
                    ]
                }
            }
        }
    }
